[Unit]
Description=Stratasys kiosk (cage + Chromium, single full-screen client)
After=stratasys-hardware.service systemd-logind.service plymouth-quit-wait.service
Requires=stratasys-hardware.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=kiosk
Group=kiosk
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=XDG_RUNTIME_DIR=/run/user/1000 XDG_SESSION_TYPE=wayland WLR_LIBINPUT_NO_DEVICES=1
# display: no cursor (touch panel), no idle blanking — the application owns
# its own screensaver/wake logic; the panel rotation comes from the kernel
# cmdline (video=...,rotate=) inside the signed boot.img
Environment=WLR_NO_HARDWARE_CURSORS=1 XCURSOR_SIZE=1
# Plymouth stays up until cage has the display, so there is never a black
# frame between the splash and the loading page
ExecStartPre=-/usr/bin/plymouth deactivate
ExecStart=/usr/bin/cage -d -- /usr/bin/chromium \
    --kiosk --noerrdialogs --no-first-run --disable-infobars --disable-translate \
    --disable-session-crashed-bubble --disable-pinch --overscroll-history-navigation=0 \
    --disable-features=Translate,TranslateUI --lang=en-US \
    --touch-events=enabled --enable-features=OverlayScrollbar \
    --password-store=basic --check-for-update-interval=31536000 --disable-component-update \
    --autoplay-policy=no-user-gesture-required --ozone-platform=wayland \
    --app=file:///usr/share/stratasys/loading.html
ExecStartPost=-/usr/bin/plymouth quit
Restart=always
RestartSec=2
StartLimitIntervalSec=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ReadWritePaths=/home/kiosk/.config /home/kiosk/.cache /run/user/1000
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
