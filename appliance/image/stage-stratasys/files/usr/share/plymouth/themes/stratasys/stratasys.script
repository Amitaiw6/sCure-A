// Stratasys boot splash (Plymouth "script" module).
// Black background, centred logo, "Starting system…" and a thin progress bar.
// Runs from the initramfs inside the signed boot.img, i.e. before the root
// filesystem is opened, and stays until cage takes the display.
// The same theme is used for shutdown ("Shutting down…") and, when the
// security service refuses Production Mode, the initramfs/agent can push a
// message ("Service required (E-VERITY)") that is shown under the logo.

Window.SetBackgroundTopColor(0.055, 0.078, 0.094);     // #0e1418
Window.SetBackgroundBottomColor(0.055, 0.078, 0.094);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 10);

message.text = "Starting system…";
message.image = Image.Text(message.text, 0.90, 0.92, 0.94, 1, "Sans 18");
message.sprite = Sprite(message.image);
message.sprite.SetPosition(Window.GetWidth() / 2 - message.image.GetWidth() / 2,
                           logo.y + logo.image.GetHeight() + 28, 10);

bar.width = Window.GetWidth() * 0.28;
bar.height = 4;
bar.x = Window.GetWidth() / 2 - bar.width / 2;
bar.y = logo.y + logo.image.GetHeight() + 78;
bar.bg = Image(bar.width, bar.height);        // track
bar.bg_sprite = Sprite(bar.bg.Scale(bar.width, bar.height));
bar.bg_sprite.SetPosition(bar.x, bar.y, 5);
bar.bg_sprite.SetOpacity(0.18);
bar.fg = Image(1, bar.height);
bar.fg_sprite = Sprite();
bar.fg_sprite.SetPosition(bar.x, bar.y, 6);

fun progress_callback(duration, progress) {
    w = bar.width * progress;
    if (w < 1) w = 1;
    bar.fg_sprite.SetImage(bar.fg.Scale(w, bar.height));
}
Plymouth.SetBootProgressFunction(progress_callback);

fun display_message_callback(text) {           // e.g. "Service required (E-VERITY)"
    message.image = Image.Text(text, 0.96, 0.60, 0.55, 1, "Sans 18");
    message.sprite.SetImage(message.image);
    message.sprite.SetPosition(Window.GetWidth() / 2 - message.image.GetWidth() / 2,
                               logo.y + logo.image.GetHeight() + 28, 10);
}
Plymouth.SetDisplayMessageFunction(display_message_callback);

fun quit_callback() { }
Plymouth.SetQuitFunction(quit_callback);

// never show a password prompt or a text console through this theme
fun display_password_callback(prompt, bullets) { }
Plymouth.SetDisplayPasswordFunction(display_password_callback);
fun display_normal_callback() { }
Plymouth.SetDisplayNormalFunction(display_normal_callback);
