        <mxCell id="n_screen" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Link Organization step: Upload Organization CSV / Sign in to Origin / Continue without organization" vertex="1"><mxGeometry x="640" y="95" width="260" height="76" as="geometry" /></mxCell>
        <mxCell id="d_choice" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" value="User choice?" vertex="1"><mxGeometry x="660" y="205" width="220" height="90" as="geometry" /></mxCell>
        <mxCell id="n_usb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="USB file browser: *.csv files on the USB drives (root + 2 folder levels)" vertex="1"><mxGeometry x="445" y="330" width="170" height="90" as="geometry" /></mxCell>
        <mxCell id="d_file" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" value="File picked?" vertex="1"><mxGeometry x="445" y="460" width="170" height="80" as="geometry" /></mxCell>
        <mxCell id="d_uuid" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" value="UUID (8-4-4-4-12) found in the file?" vertex="1"><mxGeometry x="440" y="580" width="180" height="96" as="geometry" /></mxCell>
        <mxCell id="n_nouuid" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Show &amp;quot;No valid organization ID found in CSV file&amp;quot;" vertex="1"><mxGeometry x="445" y="720" width="170" height="76" as="geometry" /></mxCell>
        <mxCell id="n_without" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="No organization (organizationId empty)" vertex="1"><mxGeometry x="930" y="330" width="170" height="60" as="geometry" /></mxCell>
        <mxCell id="n_origin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Origin website (app.origin.io) opens in a temporary browser; user signs in as on a computer" vertex="1"><mxGeometry x="1200" y="320" width="280" height="100" as="geometry" /></mxCell>
        <mxCell id="d_org" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" value="organizationId read before the time-out (default 300 s)?" vertex="1"><mxGeometry x="1230" y="460" width="220" height="100" as="geometry" /></mxCell>
