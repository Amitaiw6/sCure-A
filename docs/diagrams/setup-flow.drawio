<mxfile host="app.diagrams.net">
  <diagram id="setup-flow" name="sCure Setup Flow (CS 1.0.106)">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="lane0" parent="1" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=none;strokeColor=#888888;fontSize=15;fontStyle=1;align=center;verticalAlign=top;collapsible=0;swimlaneFillColor=none;" value="Storage" vertex="1"><mxGeometry x="0" height="1680" width="420" as="geometry" /></mxCell>
        <mxCell id="lane1" parent="1" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=none;strokeColor=#888888;fontSize=15;fontStyle=1;align=center;verticalAlign=top;collapsible=0;swimlaneFillColor=none;" value="UI sCure" vertex="1"><mxGeometry x="420" height="1680" width="660" as="geometry" /></mxCell>
        <mxCell id="lane2" parent="1" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=none;strokeColor=#888888;fontSize=15;fontStyle=1;align=center;verticalAlign=top;collapsible=0;swimlaneFillColor=none;" value="Machine" vertex="1"><mxGeometry x="1080" height="1680" width="440" as="geometry" /></mxCell>
        <mxCell id="start" parent="1" style="ellipse;shape=doubleEllipse;html=1;dashed=0;whiteSpace=wrap;aspect=fixed;" value="" vertex="1"><mxGeometry x="735" y="45" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="n_power" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Power on: firmware starts, Boot screen shows the logo" vertex="1"><mxGeometry x="640" y="95" width="220" height="56" as="geometry" /></mxCell>
        <mxCell id="d_planned" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" value="Planned restart? (clean stop &amp;le; 10 min ago)" vertex="1"><mxGeometry x="640" y="180" width="220" height="96" as="geometry" /></mxCell>
        <mxCell id="n_quick" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Quick boot: the UV LED and fan checks pass without running" vertex="1"><mxGeometry x="1170" y="193" width="260" height="70" as="geometry" /></mxCell>
        <mxCell id="n_self" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Boot self-test, in order:&lt;br&gt;1. Door Closed (waits up to 60 s)&lt;br&gt;2. Temperature Sensors (up to 5 s)&lt;br&gt;3. UV LEDs 405nm (15 s, panel rise &amp;ge; 0.8 &amp;deg;C)&lt;br&gt;4. UV LEDs 450nm (30 s, same rule)&lt;br&gt;5. Chamber Fans (tachometers)&lt;br&gt;6. API Server&lt;br&gt;&lt;i&gt;LED checks fail as skipped when the door is not closed&lt;/i&gt;" vertex="1"><mxGeometry x="1130" y="320" width="340" height="170" as="geometry" /></mxCell>
        <mxCell id="d_allok" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" value="All 6 checks passed?" vertex="1"><mxGeometry x="640" y="520" width="220" height="90" as="geometry" /></mxCell>
        <mxCell id="n_fail" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Show failed checks and reasons: Retry / Continue anyway" vertex="1"><mxGeometry x="905" y="530" width="160" height="76" as="geometry" /></mxCell>
        <mxCell id="s_read" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Read setupComplete (ui-settings.json, else system.json)" vertex="1"><mxGeometry x="95" y="650" width="240" height="64" as="geometry" /></mxCell>
        <mxCell id="d_setup" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" value="Setup completed?" vertex="1"><mxGeometry x="640" y="640" width="220" height="90" as="geometry" /></mxCell>
        <mxCell id="n_home" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Home screen (&amp;sect;6)" vertex="1"><mxGeometry x="905" y="655" width="160" height="56" as="geometry" /></mxCell>
        <mxCell id="f_home" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" value="" vertex="1"><mxGeometry x="972" y="745" width="26" height="26" as="geometry" /></mxCell>
        <mxCell id="n_welcome" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Welcome screen: user presses Get Started" vertex="1"><mxGeometry x="640" y="790" width="220" height="56" as="geometry" /></mxCell>
        <mxCell id="s_sn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Read serialNumber (ui-settings.json, else system.json)" vertex="1"><mxGeometry x="95" y="885" width="240" height="64" as="geometry" /></mxCell>
        <mxCell id="d_sn" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" value="Serial number already stored?" vertex="1"><mxGeometry x="640" y="875" width="220" height="90" as="geometry" /></mxCell>
        <mxCell id="n_wait" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Serial Number step: wait for a USB barcode scan (cannot be skipped)" vertex="1"><mxGeometry x="640" y="1005" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="n_scan" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="USB barcode scanner types the code, then Enter" vertex="1"><mxGeometry x="1170" y="1010" width="260" height="60" as="geometry" /></mxCell>
        <mxCell id="n_manual" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Service only: 10 taps on the barcode label + device password unlock typing it on the on-screen keyboard" vertex="1"><mxGeometry x="435" y="1110" width="180" height="100" as="geometry" /></mxCell>
        <mxCell id="d_valid" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" value="Valid serial number? (3-40 chars)" vertex="1"><mxGeometry x="640" y="1120" width="220" height="96" as="geometry" /></mxCell>
        <mxCell id="n_invalid" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Show &amp;quot;&amp;lt;code&amp;gt; is not a valid serial number&amp;quot;" vertex="1"><mxGeometry x="905" y="1133" width="150" height="70" as="geometry" /></mxCell>
        <mxCell id="n_shown" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Show the serial number; Next enabled (a new scan replaces it)" vertex="1"><mxGeometry x="640" y="1260" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="s_save" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Save serialNumber to ui-settings.json" vertex="1"><mxGeometry x="95" y="1370" width="240" height="64" as="geometry" /></mxCell>
        <mxCell id="n_next" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="User presses Next" vertex="1"><mxGeometry x="640" y="1375" width="220" height="54" as="geometry" /></mxCell>
        <mxCell id="n_toname" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Proceed to the Name step (&amp;sect;4)" vertex="1"><mxGeometry x="640" y="1490" width="220" height="54" as="geometry" /></mxCell>
