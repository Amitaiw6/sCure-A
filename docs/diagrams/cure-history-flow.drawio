<mxfile host="app.diagrams.net">
  <diagram id="cure-history-flow" name="sCure Cure History Flow">
    <mxGraphModel dx="1664" dy="986" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1840" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="laneU" parent="1" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=none;strokeColor=#888888;fontSize=15;fontStyle=1;align=center;verticalAlign=top;collapsible=0;swimlaneFillColor=none;" value="UI sCure" vertex="1"><mxGeometry x="0" y="0" width="600" height="1820" as="geometry" /></mxCell>
        <mxCell id="laneM" parent="1" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=none;strokeColor=#888888;fontSize=15;fontStyle=1;align=center;verticalAlign=top;collapsible=0;swimlaneFillColor=none;" value="Machine" vertex="1"><mxGeometry x="600" y="0" width="400" height="1820" as="geometry" /></mxCell>
        <mxCell id="laneS" parent="1" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=none;strokeColor=#888888;fontSize=15;fontStyle=1;align=center;verticalAlign=top;collapsible=0;swimlaneFillColor=none;" value="Storage" vertex="1"><mxGeometry x="1000" y="0" width="360" height="1820" as="geometry" /></mxCell>
        <mxCell id="laneC" parent="1" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=none;strokeColor=#888888;fontSize=15;fontStyle=1;align=center;verticalAlign=top;collapsible=0;swimlaneFillColor=none;" value="Cloud" vertex="1"><mxGeometry x="1360" y="0" width="300" height="1820" as="geometry" /></mxCell>
        <mxCell id="start" parent="1" style="ellipse;shape=doubleEllipse;html=1;dashed=0;whiteSpace=wrap;aspect=fixed;fillColor=#FFFFFF;strokeColor=#000000;" value="" vertex="1"><mxGeometry x="155" y="45" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="n_tap" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Tap the History icon in the top bar&lt;br&gt;(inert while a cure is running)" vertex="1"><mxGeometry x="40" y="95" width="260" height="50" as="geometry" /></mxCell>
        <mxCell id="n_open" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Open Cure History&lt;br&gt;Back returns to the previous screen, else Home" vertex="1"><mxGeometry x="40" y="175" width="260" height="60" as="geometry" /></mxCell>
        <mxCell id="s_read" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Read the cure history (database when available, else the device files); only the newest 25 runs are kept (older runs go when a new run starts). Unreadable store = empty list" vertex="1"><mxGeometry x="1015" y="165" width="330" height="90" as="geometry" /></mxCell>
        <mxCell id="d_any" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" value="Any runs?" vertex="1"><mxGeometry x="70" y="290" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="n_empty" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Show 'No cure sessions yet.'" vertex="1"><mxGeometry x="330" y="305" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="e_empty" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" value="" vertex="1"><mxGeometry x="437" y="385" width="26" height="26" as="geometry" /></mxCell>
        <mxCell id="n_list" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="List newest first + count (N) + 'last 25 kept'. Row: status icon, material, status pill (Completed / Stopped / Error / Running), start date 'to HH:mm', sensor / fan issue lines, duration, steps X/Y (orange if incomplete)" vertex="1"><mxGeometry x="20" y="400" width="300" height="100" as="geometry" /></mxCell>
        <mxCell id="n_sel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Select the run that was opened, else the newest; detail panel: status, date, duration, steps, max chamber temp, samples, phases" vertex="1"><mxGeometry x="20" y="525" width="300" height="75" as="geometry" /></mxCell>
        <mxCell id="d_act" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" value="Operator action?" vertex="1"><mxGeometry x="60" y="625" width="220" height="90" as="geometry" /></mxCell>
        <mxCell id="d_tel" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" value="Selected run has telemetry samples?" vertex="1"><mxGeometry x="680" y="630" width="240" height="80" as="geometry" /></mxCell>
        <mxCell id="n_noexp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Export report disabled" vertex="1"><mxGeometry x="680" y="540" width="240" height="45" as="geometry" /></mxCell>
        <mxCell id="e_noexp" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" value="" vertex="1"><mxGeometry x="950" y="549" width="26" height="26" as="geometry" /></mxCell>
        <mxCell id="d_stored" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" value="Report already saved with the run?" vertex="1"><mxGeometry x="1060" y="630" width="240" height="80" as="geometry" /></mxCell>
        <mxCell id="n_build" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Build the HTML cure report: metrics, program steps, timing diagram, alerts during the run, chamber / LED / fan charts, sensor &amp;amp; fan notes" vertex="1"><mxGeometry x="650" y="865" width="300" height="95" as="geometry" /></mxCell>
        <mxCell id="s_save" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Save the report with the run" vertex="1"><mxGeometry x="1040" y="885" width="280" height="55" as="geometry" /></mxCell>
        <mxCell id="d_usb" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" value="USB drive found?" vertex="1"><mxGeometry x="680" y="1010" width="240" height="80" as="geometry" /></mxCell>
        <mxCell id="E_nousb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF5F5;strokeColor=#cc0000;fontColor=#990000;fontSize=11;" value="[Err 9081] 'No USB drive found'" vertex="1"><mxGeometry x="330" y="1025" width="250" height="50" as="geometry" /></mxCell>
        <mxCell id="x_nousb" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#cc0000;fontColor=#cc0000;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" value="&amp;#10007;" vertex="1"><mxGeometry x="440" y="1100" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="d_write" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" value="Report file written to the USB drive?" vertex="1"><mxGeometry x="680" y="1150" width="240" height="80" as="geometry" /></mxCell>
        <mxCell id="E_write" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF5F5;strokeColor=#cc0000;fontColor=#990000;fontSize=11;" value="[Err 9082] 'Could not write to the USB drive'" vertex="1"><mxGeometry x="330" y="1165" width="250" height="50" as="geometry" /></mxCell>
        <mxCell id="x_write" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#cc0000;fontColor=#cc0000;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" value="&amp;#10007;" vertex="1"><mxGeometry x="440" y="1240" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="n_saved" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="'Saved to USB' (the message clears after 3 s)" vertex="1"><mxGeometry x="330" y="1290" width="250" height="50" as="geometry" /></mxCell>
        <mxCell id="e_saved" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" value="" vertex="1"><mxGeometry x="442" y="1365" width="26" height="26" as="geometry" /></mxCell>
        <mxCell id="n_delc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Delete (selected finished run) or Delete all (every finished run): confirmation dialog - removed from the machine and from sCure Cloud, cannot be undone" vertex="1"><mxGeometry x="20" y="1420" width="300" height="90" as="geometry" /></mxCell>
        <mxCell id="d_ok" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" value="Confirmed?" vertex="1"><mxGeometry x="70" y="1540" width="200" height="70" as="geometry" /></mxCell>
