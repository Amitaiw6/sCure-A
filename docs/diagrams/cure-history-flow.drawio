        <mxCell id="s_del" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Remove the run(s) with telemetry and report; a run in progress is never deleted" vertex="1"><mxGeometry x="1020" y="1530" width="320" height="90" as="geometry" /></mxCell>
        <mxCell id="c_queue" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Queue the run ids for deletion on sCure Cloud; sent on the next sync, kept until the portal confirms" vertex="1"><mxGeometry x="1380" y="1530" width="260" height="90" as="geometry" /></mxCell>
        <mxCell id="n_deleted" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="'Run deleted' / 'Delete failed'; list reloaded, the next run selected" vertex="1"><mxGeometry x="330" y="1690" width="250" height="60" as="geometry" /></mxCell>
        <mxCell id="e_del" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" value="" vertex="1"><mxGeometry x="442" y="1770" width="26" height="26" as="geometry" /></mxCell>
        <mxCell id="note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;arcSize=6;fillColor=#F7F7F7;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;Where the runs come from&lt;/b&gt;&lt;br&gt;The cure run itself writes the history (Section 7): start, one telemetry sample every 2 s, finish with the status, sensor / fan issues and the alerts raised during the run. When a run completes, its report is built, saved with the run and exported to USB once automatically; Cure History exports it again on request." vertex="1"><mxGeometry x="630" y="1400" width="340" height="150" as="geometry" /></mxCell>
