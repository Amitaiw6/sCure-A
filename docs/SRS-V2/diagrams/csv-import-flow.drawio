<mxfile host="app.diagrams.net">
  <diagram id="csv-import-flow" name="sCure CSV Import Flow">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1220" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="laneU" parent="1" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=none;strokeColor=#888888;fontSize=15;fontStyle=1;align=center;verticalAlign=top;collapsible=0;swimlaneFillColor=none;" value="UI" vertex="1"><mxGeometry height="1180" width="700" x="0" as="geometry" /></mxCell>
        <mxCell id="laneF" parent="1" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=none;strokeColor=#888888;fontSize=15;fontStyle=1;align=center;verticalAlign=top;collapsible=0;swimlaneFillColor=none;" value="FW" vertex="1"><mxGeometry height="1180" width="520" x="700" as="geometry" /></mxCell>
        <mxCell id="laneS" parent="1" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=none;strokeColor=#888888;fontSize=15;fontStyle=1;align=center;verticalAlign=top;collapsible=0;swimlaneFillColor=none;" value="Storage" vertex="1"><mxGeometry height="1180" width="460" x="1220" as="geometry" /></mxCell>
        <mxCell id="start" parent="1" style="ellipse;shape=doubleEllipse;html=1;dashed=0;whiteSpace=wrap;aspect=fixed;fillColor=#FFFFFF;strokeColor=#000000;" value="" vertex="1"><mxGeometry height="30" width="30" x="335" y="40" as="geometry" /></mxCell>
        <mxCell id="press" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Press 'CSV': open 'Import from CSV' (example table + limits)" vertex="1"><mxGeometry height="54" width="260" x="220" y="90" as="geometry" /></mxCell>
        <mxCell id="browse" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Tap browse: the USB file picker lists *.csv on every USB drive (root + 2 folder levels, up to 200 files)" vertex="1"><mxGeometry height="70" width="300" x="200" y="175" as="geometry" /></mxCell>
        <mxCell id="d_pick" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" value="File picked?" vertex="1"><mxGeometry height="64" width="170" x="265" y="275" as="geometry" /></mxCell>
        <mxCell id="read" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Read the file text from the USB drive" vertex="1"><mxGeometry height="54" width="230" x="1335" y="280" as="geometry" /></mxCell>
        <mxCell id="d_read" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" value="Readable?" vertex="1"><mxGeometry height="64" width="170" x="1365" y="370" as="geometry" /></mxCell>
        <mxCell id="e_read" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#cc0000;fontSize=12;" value="'[file] — Failed': 'Cannot read file: ...'" vertex="1"><mxGeometry height="54" width="240" x="1330" y="470" as="geometry" /></mxCell>
        <mxCell id="x_read" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#cc0000;fontColor=#cc0000;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" value="&#10007;" vertex="1"><mxGeometry height="26" width="26" x="1437" y="560" as="geometry" /></mxCell>
        <mxCell id="p1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Structure: header row + at least 1 data row; the header names Step or Process [6006]" vertex="1"><mxGeometry height="60" width="300" x="810" y="370" as="geometry" /></mxCell>
        <mxCell id="p2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Per row (a failing row is reported and skipped): at least 4 columns; Process exactly Heating / Drying / Cure / Cooling / Bleacher / Nitrogen [6007]" vertex="1"><mxGeometry height="80" width="300" x="810" y="460" as="geometry" /></mxCell>
        <mxCell id="p3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Time 1–120 min (Bleacher 1–720) on heat / UV rows [6009]; temperature 30–80 °C (Drying 30–50, Cooling 30–75; 'off' on Cure / Bleacher = UV only) [6008]; UV 10–100 %" vertex="1"><mxGeometry height="90" width="300" x="810" y="570" as="geometry" /></mxCell>
        <mxCell id="p4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Program rules on the parsed steps: max 2 N₂ purges [6010]; N₂ → Cure/Bleaching → Cooling [6003]; no temperature drop without Cooling [6004]; Cooling at least 5 °C below the previous step [6005]" vertex="1"><mxGeometry height="100" width="300" x="810" y="690" as="geometry" /></mxCell>
        <mxCell id="d_any" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" value="Any message collected?" vertex="1"><mxGeometry height="76" width="220" x="850" y="820" as="geometry" /></mxCell>
        <mxCell id="fail" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#cc0000;fontSize=12;" value="'[file] — Failed' with every collected message listed beneath it; nothing added" vertex="1"><mxGeometry height="66" width="270" x="215" y="825" as="geometry" /></mxCell>
        <mxCell id="x_fail" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#cc0000;fontColor=#cc0000;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" value="&#10007;" vertex="1"><mxGeometry height="26" width="26" x="337" y="925" as="geometry" /></mxCell>
        <mxCell id="create" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Create the program: name = file name without '.csv'; steps normalised; estimate" vertex="1"><mxGeometry height="60" width="280" x="820" y="930" as="geometry" /></mxCell>
        <mxCell id="save" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Add to the user programs at once (a later failed file does not roll it back)" vertex="1"><mxGeometry height="60" width="260" x="1320" y="930" as="geometry" /></mxCell>
        <mxCell id="ok" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="'[file] — Added'; the Program List reloads when the dialog closes (not auto-selected)" vertex="1"><mxGeometry height="66" width="270" x="215" y="1030" as="geometry" /></mxCell>
        <mxCell id="f_ok" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" value="" vertex="1"><mxGeometry height="26" width="26" x="337" y="1130" as="geometry" /></mxCell>
        <mxCell id="note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;arcSize=6;fillColor=#F7F7F7;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacing=8;" value="Files are picked and imported one at a time. Done is enabled only when there is at least one result and none failed; Cancel always closes." vertex="1"><mxGeometry height="120" width="200" x="20" y="1000" as="geometry" /></mxCell>
        <mxCell id="e1" edge="1" parent="1" source="start" target="press" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;fontSize=11;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="press" target="browse" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;fontSize=11;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="browse" target="d_pick" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;fontSize=11;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" edge="1" parent="1" source="d_pick" target="browse" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="no (Cancel)"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="130" y="307" /><mxPoint x="130" y="210" /></Array></mxGeometry></mxCell>
        <mxCell id="e5" edge="1" parent="1" source="d_pick" target="read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="yes"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" edge="1" parent="1" source="read" target="d_read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;fontSize=11;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" edge="1" parent="1" source="d_read" target="e_read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="no"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" edge="1" parent="1" source="e_read" target="x_read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;fontSize=11;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" edge="1" parent="1" source="d_read" target="p1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" value="yes"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" edge="1" parent="1" source="p1" target="p2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;fontSize=11;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" edge="1" parent="1" source="p2" target="p3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;fontSize=11;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
