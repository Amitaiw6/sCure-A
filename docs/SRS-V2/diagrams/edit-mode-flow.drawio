<mxfile host="app.diagrams.net">
  <diagram id="edit-mode-flow" name="sCure Edit Mode Flow">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="840" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="laneU" parent="1" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=none;strokeColor=#888888;fontSize=15;fontStyle=1;align=center;verticalAlign=top;collapsible=0;swimlaneFillColor=none;" value="UI" vertex="1"><mxGeometry height="800" width="700" x="0" as="geometry" /></mxCell>
        <mxCell id="laneF" parent="1" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=none;strokeColor=#888888;fontSize=15;fontStyle=1;align=center;verticalAlign=top;collapsible=0;swimlaneFillColor=none;" value="FW" vertex="1"><mxGeometry height="800" width="520" x="700" as="geometry" /></mxCell>
        <mxCell id="laneS" parent="1" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=none;strokeColor=#888888;fontSize=15;fontStyle=1;align=center;verticalAlign=top;collapsible=0;swimlaneFillColor=none;" value="Storage" vertex="1"><mxGeometry height="800" width="460" x="1220" as="geometry" /></mxCell>
        <mxCell id="start" parent="1" style="ellipse;shape=doubleEllipse;html=1;dashed=0;whiteSpace=wrap;aspect=fixed;fillColor=#FFFFFF;strokeColor=#000000;" value="" vertex="1"><mxGeometry height="30" width="30" x="335" y="40" as="geometry" /></mxCell>
        <mxCell id="press" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Press 'Edit' (shown only when at least one program exists)" vertex="1"><mxGeometry height="54" width="260" x="220" y="90" as="geometry" /></mxCell>
        <mxCell id="enter" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Edit mode: the button reads 'Done'; rows show Duplicate, plus Edit and Delete on user programs; row taps do not select" vertex="1"><mxGeometry height="70" width="320" x="190" y="170" as="geometry" /></mxCell>
        <mxCell id="d_act" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" value="Operator action?" vertex="1"><mxGeometry height="70" width="190" x="255" y="275" as="geometry" /></mxCell>
        <mxCell id="dup" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Duplicate (any program): name '[name] Copy', then 'Copy 2', 'Copy 3'... until unique; new id; user program; estimate" vertex="1"><mxGeometry height="90" width="300" x="810" y="265" as="geometry" /></mxCell>
        <mxCell id="dup_s" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Save the copy to the user programs at once" vertex="1"><mxGeometry height="54" width="230" x="1335" y="283" as="geometry" /></mxCell>
        <mxCell id="dup_u" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Open 'Edit Program' on the copy (Section 6.7.1); Cancel keeps the copy" vertex="1"><mxGeometry height="66" width="260" x="1320" y="370" as="geometry" /></mxCell>
        <mxCell id="edit" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Edit (user program): open 'Edit Program' pre-filled; 'Update Program' saves" vertex="1"><mxGeometry height="66" width="240" x="230" y="400" as="geometry" /></mxCell>
        <mxCell id="edit_s" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Replace the program by id" vertex="1"><mxGeometry height="44" width="220" x="1340" y="630" as="geometry" /></mxCell>
        <mxCell id="del" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Delete (user program): confirm 'Delete “[name]”?' (cannot be undone)" vertex="1"><mxGeometry height="80" width="190" x="495" y="400" as="geometry" /></mxCell>
        <mxCell id="d_conf" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" value="Confirmed?" vertex="1"><mxGeometry height="64" width="170" x="505" y="510" as="geometry" /></mxCell>
        <mxCell id="del_s" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Remove from the user programs and the favorites; clear the selection if it was selected" vertex="1"><mxGeometry height="66" width="270" x="1315" y="500" as="geometry" /></mxCell>
        <mxCell id="done" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Done: leave edit mode (the button reads 'Edit')" vertex="1"><mxGeometry height="66" width="190" x="25" y="400" as="geometry" /></mxCell>
        <mxCell id="f_done" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" value="" vertex="1"><mxGeometry height="26" width="26" x="107" y="500" as="geometry" /></mxCell>
        <mxCell id="note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;arcSize=6;fillColor=#F7F7F7;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacing=8;" value="Presets: only Duplicate is offered (the Edit and Delete icons are not shown) and Delete ignores presets. A preset is changed only by duplicating it and editing the copy." vertex="1"><mxGeometry height="70" width="420" x="750" y="710" as="geometry" /></mxCell>
        <mxCell id="e1" edge="1" parent="1" source="start" target="press" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;fontSize=11;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="press" target="enter" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;fontSize=11;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="enter" target="d_act" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;fontSize=11;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" edge="1" parent="1" source="d_act" target="dup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="Duplicate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" edge="1" parent="1" source="dup" target="dup_s" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" edge="1" parent="1" source="dup_s" target="dup_u" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="open"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" edge="1" parent="1" source="d_act" target="edit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="Edit"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" edge="1" parent="1" source="edit" target="edit_s" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="Update"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="652" /></Array></mxGeometry></mxCell>
        <mxCell id="e9" edge="1" parent="1" source="d_act" target="del" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;fontSize=11;exitX=0.75;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="Delete"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="590" y="328" /></Array></mxGeometry></mxCell>
        <mxCell id="e10" edge="1" parent="1" source="del" target="d_conf" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;fontSize=11;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" edge="1" parent="1" source="d_conf" target="del_s" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="yes"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" edge="1" parent="1" source="d_conf" target="enter" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" value="no"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="590" y="600" /><mxPoint x="690" y="600" /><mxPoint x="690" y="205" /></Array></mxGeometry></mxCell>
        <mxCell id="e13" edge="1" parent="1" source="d_act" target="done" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="Done"><mxGeometry relative="1" as="geometry" /></mxCell>
