        <mxCell id="u_home" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="&lt;b&gt;Home → Start Cure&lt;/b&gt; (§6.8): no critical alert, door closed,&lt;br&gt;fan pre-check passed or overridden" vertex="1">
          <mxGeometry x="80" y="100" width="480" height="58" as="geometry" />
        </mxCell>
        <mxCell id="u_open" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="&lt;b&gt;Cure Process opens&lt;/b&gt; with the program; N₂ steps are dropped&lt;br&gt;when Nitrogen Mode is off; pre-check spinner stays up" vertex="1">
          <mxGeometry x="40" y="196" width="560" height="58" as="geometry" />
        </mxCell>
        <mxCell id="f_start" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="&lt;b&gt;Start run&lt;/b&gt; — refused while a run or a process is active (6015)&lt;br&gt;or when the program fails validation (7001–7003)" vertex="1">
          <mxGeometry x="700" y="192" width="490" height="66" as="geometry" />
        </mxCell>
        <mxCell id="d_ok" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" value="Start accepted?" vertex="1">
          <mxGeometry x="830" y="290" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="u_ref" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#cc0000;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;" value="&lt;b&gt;Start refused&lt;/b&gt; — sensor not reading (901x) / frozen reading (9006):&lt;br&gt;Heater-fault dialog, Retry or Cancel; any other code:&lt;br&gt;message with the registry text → Home" vertex="1">
          <mxGeometry x="40" y="296" width="560" height="68" as="geometry" />
        </mxCell>
        <mxCell id="x_ref" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#cc0000;fontColor=#cc0000;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" value="✗" vertex="1">
          <mxGeometry x="305" y="382" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lbl_ref" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#cc0000;fontStyle=1;" value="Err 6015 · 901x · 9006" vertex="1">
          <mxGeometry x="342" y="382" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s_run" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="&lt;b&gt;Run record created&lt;/b&gt; (status running): material, steps,&lt;br&gt;phases, first target, serial number" vertex="1">
          <mxGeometry x="1250" y="296" width="420" height="68" as="geometry" />
        </mxCell>
        <mxCell id="f_pre" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;" value="&lt;b&gt;Begin step i — step pre-flight&lt;/b&gt;&lt;br&gt;• critical fan latched (9020–9025) · frozen-reading latch (9006)&lt;br&gt;• required NTCs read: chamber / Left / Right (9010–9012)&lt;br&gt;• Drying, Cooling: chamber-fan spin test (9034)&lt;br&gt;• UV: LED-fan spin test of the panels to light (9030–9033)" vertex="1">
          <mxGeometry x="700" y="410" width="490" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_pre" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" value="Pre-flight passed?" vertex="1">
          <mxGeometry x="830" y="530" width="230" height="76" as="geometry" />
        </mxCell>
        <mxCell id="d_type" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" value="Step type?&lt;br&gt;(1 s tick: ramp, hold, purge)" vertex="1">
          <mxGeometry x="820" y="640" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s_tel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="&lt;b&gt;Telemetry every 2 s&lt;/b&gt;: chamber + LED temperatures, fan RPM&lt;br&gt;and duty, heater PWM, UV outputs / intensity, damper, N₂, door" vertex="1">
          <mxGeometry x="1250" y="650" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f_heat" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;" value="&lt;b&gt;Heating / Drying&lt;/b&gt; — heater PI to target (heater-fan spin first)&lt;br&gt;Drying at target ± 1.5 °C: damper open + chamber fan 30 %&lt;br&gt;Ends: chamber ≥ target − 0.5 °C, then the hold time" vertex="1">
          <mxGeometry x="700" y="770" width="490" height="84" as="geometry" />
        </mxCell>
        <mxCell id="f_cure" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;" value="&lt;b&gt;Cure 405 nm / Bleaching 450 nm&lt;/b&gt; — heater to target;&lt;br&gt;UV lit at step start or at target (UV Start);&lt;br&gt;timer from step start or from target (Timer Start).&lt;br&gt;No temperature: heater off, UV at once (opt. ventilation)&lt;br&gt;Ends: hold time elapsed, never before the target" vertex="1">
          <mxGeometry x="700" y="868" width="490" height="96" as="geometry" />
        </mxCell>
        <mxCell id="f_cool" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;" value="&lt;b&gt;Cooling&lt;/b&gt; — UV + heater off, damper open, chamber fan fixed&lt;br&gt;100 / 60 / 30 % (Fast also LED fans). Ends: chamber ≤ target + 0.5 °C" vertex="1">
          <mxGeometry x="700" y="978" width="490" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f_n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;" value="&lt;b&gt;N₂ Purge&lt;/b&gt; — valve open for a fixed 120 s, nothing else switched" vertex="1">
          <mxGeometry x="700" y="1062" width="490" height="44" as="geometry" />
        </mxCell>
        <mxCell id="d_last" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" value="Last step done?" vertex="1">
          <mxGeometry x="830" y="1132" width="230" height="78" as="geometry" />
        </mxCell>
        <mxCell id="s_tim" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="&lt;b&gt;Phase-timing record per step&lt;/b&gt;: seconds, ramp seconds,&lt;br&gt;start / end temperature, cooling mode, intensity, timer mode" vertex="1">
          <mxGeometry x="1250" y="1135" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f_end" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="&lt;b&gt;Program completed&lt;/b&gt; — UV, heater, N₂, cooling off, damper closed;&lt;br&gt;heater fan run-on 30 % for 15 min" vertex="1">
          <mxGeometry x="700" y="1240" width="490" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s_done" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="&lt;b&gt;Run finished: completed&lt;/b&gt; — steps completed, alerts&lt;br&gt;during the run, sensor and fan issues" vertex="1">
          <mxGeometry x="1250" y="1236" width="420" height="68" as="geometry" />
        </mxCell>
        <mxCell id="u_sup" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;" value="&lt;b&gt;Cure screen — every second while the run is running&lt;/b&gt;&lt;br&gt;• Door open → 10 s countdown; door closed in time → run continues&lt;br&gt;• Chamber sensor lost (9010) → run paused → Retry / Stop process&lt;br&gt;• Frozen reading (9006) → run paused → Stop process&lt;br&gt;• Fan failure (9020–9025, 9030–9034) → run paused →&lt;br&gt;&amp;nbsp;&amp;nbsp;Continue anyway (fan overridden) / Stop process&lt;br&gt;• LED panel not heating (9040–9045, only with LED checks on) →&lt;br&gt;&amp;nbsp;&amp;nbsp;run paused → Continue anyway / Stop process&lt;br&gt;• Ramp / cooling: &amp;lt; 1 °C progress per 5 min, 5 times →&lt;br&gt;&amp;nbsp;&amp;nbsp;Temperature Warning (7004) → Continue / Abort&lt;br&gt;&lt;b&gt;Operator&lt;/b&gt;&lt;br&gt;• Pause → Pause &amp;amp; Open Door: outputs off, clocks frozen,&lt;br&gt;&amp;nbsp;&amp;nbsp;door released → Continue (door closed) / Stop Process&lt;br&gt;• Abort → Stop the Cure Process? → Yes, Stop" vertex="1">
          <mxGeometry x="40" y="452" width="560" height="300" as="geometry" />
        </mxCell>
        <mxCell id="lbl_7004" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#cc0000;fontStyle=1;" value="Err 7004" vertex="1">
          <mxGeometry x="40" y="758" width="200" height="24" as="geometry" />
        </mxCell>
        <mxCell id="u_done" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="&lt;b&gt;Cure Complete!&lt;/b&gt; — material, total time (pauses excluded), steps;&lt;br&gt;report built and saved, exported to USB when a drive is in" vertex="1">
          <mxGeometry x="40" y="1236" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="u_door" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="Open Door → door magnet released for 2 s → Home" vertex="1">
          <mxGeometry x="80" y="1328" width="480" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_done" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" value="" vertex="1">
          <mxGeometry x="305" y="1396" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="f_abort" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#cc0000;fontSize=12;" value="&lt;b&gt;Abort&lt;/b&gt; — stop all outputs (heater fan run-on)" vertex="1">
          <mxGeometry x="700" y="1424" width="490" height="52" as="geometry" />
        </mxCell>
        <mxCell id="s_abort" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="&lt;b&gt;Run finished: aborted&lt;/b&gt; (no code) — steps completed, alerts" vertex="1">
          <mxGeometry x="1250" y="1420" width="420" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f_err" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#cc0000;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;" value="&lt;b&gt;Run fails&lt;/b&gt; — step command refused (pre-flight / hardware), door&lt;br&gt;open 10 s with outputs live (6016), heater not heating (9007)&lt;br&gt;or a heater fault without a code → stop all outputs" vertex="1">
          <mxGeometry x="700" y="1506" width="490" height="84" as="geometry" />
        </mxCell>
        <mxCell id="s_err" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="&lt;b&gt;Run finished: error&lt;/b&gt; + code; the failure is added&lt;br&gt;to the run's alerts" vertex="1">
          <mxGeometry x="1250" y="1514" width="420" height="68" as="geometry" />
        </mxCell>
        <mxCell id="u_back" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" value="&lt;b&gt;Return to Home&lt;/b&gt; — error: dialog with the code (sensor fault:&lt;br&gt;heater-fault dialog); 6016 stays on the Alerts screen" vertex="1">
          <mxGeometry x="40" y="1474" width="560" height="60" as="geometry" />
